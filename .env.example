# Copy this file to .env.local and fill it in. Never commit .env.local.

# Neon → your project → Connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Your details
BIRTH_DATE="2002-01-01"          # YYYY-MM-DD, the timeline starts here
OWNER_NAME="Sanket"              # shown as "Sanket's Life"
OWNER_EMAIL="you@gmail.com"      # the only Google account allowed to sign in and edit
TIMEZONE="Asia/Kolkata"

# "true" = anyone with the link can read the timeline; "false" = only you, after signing in
PUBLIC_VIEW="false"

# Auth.js. Generate the secret with:  npx auth secret
AUTH_SECRET=""
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
